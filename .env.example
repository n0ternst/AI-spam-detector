# Режим работы текстового детектора: remote (через API), features (только признаки на CPU), local
LLM_MODE=remote

# URL сервера с Qwen2.5-1.5B-Instruct в контуре Разработчика (RTX 4060)
# Если клиент в Docker на той же машине: http://host.docker.internal:8000/v1
# Если в локальной сети / VPN: http://<IP_ВАШЕГО_ПК>:8000/v1
LLM_API_URL=http://192.168.1.100:8000/v1

# Опциональный ключ доступа (не коммитить реальные ключи в репозиторий!)
LLM_API_KEY=dw1-local-contour-key

# Таймаут ответа языковой модели по ТЗ (не более 180 с)
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.5
LOG_LEVEL=INFO